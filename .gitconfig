[user]
	name = SimY4
	email = alex.simkin@outlook.com
	signingkey = ~/.ssh/id_ed25519.pub
[core]
	autocrlf = input
[pull]
	rebase = true
[rebase]
	autoStash = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[push]
  default = current
